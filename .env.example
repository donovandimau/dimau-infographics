# Public address of this app (used in the generated SDK and embed snippets)
NEXT_PUBLIC_APP_URL=https://dimau-infographics.vercel.app

# Supabase (registry). Without these the app serves the four built-in starter templates.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Studio: one admin key for saving templates, server previews and AI. Make it long and random.
STUDIO_ADMIN_KEY=

# Extra browser origins allowed to call the API (comma-separated); *.vercel.app and Dimau domains are built in.
ALLOWED_ORIGINS=

# AI text-to-DSL: any OpenAI-compatible endpoint (Ollama: http://<host>:11434/v1)
AI_TEXT_ENDPOINT=
AI_TEXT_MODEL=
AI_TEXT_KEY=

# AI image model (e.g. a SenseNova infographic model on a Hugging Face inference endpoint)
HF_INFOGRAPHIC_ENDPOINT=
HF_TOKEN=
